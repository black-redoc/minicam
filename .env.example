# RTSP — URL construida internamente: rtsp://<user>:<pass>@<host>:<rtsp_port>/h264/ch<channel>/<stream>/av_stream
CAMERA_HOST=192.168.1.100
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=changeme
CAMERA_CHANNEL=1
# CAMERA_STREAM options: main (alta resolución) o sub (baja resolución)
CAMERA_STREAM=main

# ONVIF PTZ — puerto estándar IPCAM
CAMERA_ONVIF_PORT=8000

# App
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=false
