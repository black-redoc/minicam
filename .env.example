# Secret used to sign session and stream JWTs. Required — the app refuses to
# start without it or with this example value (see app/security_settings.py).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MINICAM_JWT_SECRET=changeme-generate-a-random-64-char-hex-string

# How long a login session stays valid, in seconds. Default: 86400 (24h).
MINICAM_SESSION_TTL_SECONDS=86400

# How long a signed camera-stream token stays valid, in seconds. Short-lived
# on purpose — see spec.md section 10 ("URL obscurity is never a security
# control"). Default: 30.
MINICAM_STREAM_TOKEN_TTL_SECONDS=30

# Path to the SQLite database file (users, sessions, permissions, WAN gate).
# Default: minicam.db next to the project root.
MINICAM_DB_PATH=minicam.db

# Comma-separated IPs that are allowed to force a request into the WAN zone
# even though it looks local. Set this to 127.0.0.1 once cloudflared runs on
# this same machine and proxies WAN traffic to localhost:8080 — see
# app/services/network.py for why this is safe (LAN clients never connect
# through cloudflared, so 127.0.0.1 here only ever means "came through the
# tunnel").
MINICAM_TRUSTED_PROXIES=127.0.0.1

# Cloudflare Access team domain (Zero Trust dashboard -> Settings -> Custom
# Pages, or your team's login URL), used to fetch the JWKS that verifies the
# Cf-Access-Jwt-Assertion header. Example: https://myteam.cloudflareaccess.com
# Leave empty if you don't use Cloudflare Tunnel; minicam refuses to start
# with the example value.
MINICAM_CF_ACCESS_TEAM_DOMAIN=

# Audience (AUD) tag of the Cloudflare Access application protecting this
# tunnel hostname. Zero Trust dashboard -> Access -> Applications -> your app
# -> Overview.
MINICAM_CF_ACCESS_AUD=

# Model catalog for the AI Detection page (minicam-models release manifest).
# Defaults to the latest release; pin a tag to freeze model versions, e.g.
# https://github.com/black-redoc/minicam-models/releases/download/v0.1.0/manifest.json
# MINICAM_MODEL_CATALOG_URL=

# Contact (mailto: or https: URL) sent to browser push services with every
# Web Push detection notification (VAPID, RFC 8292). Some push services
# reject placeholder contacts, so set your own. Default: mailto:minicam@example.com
# MINICAM_VAPID_SUBJECT=mailto:you@example.com
