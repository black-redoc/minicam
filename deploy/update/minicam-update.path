# Starts minicam-update.service when an admin asks minicam for an update
# (ADR 0013). minicam only writes this one file; the helper acts on it.
[Unit]
Description=Watch for minicam's update requests

[Path]
PathExists=/opt/minicam/.update/request.json
Unit=minicam-update.service

[Install]
WantedBy=multi-user.target
